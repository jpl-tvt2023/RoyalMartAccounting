{
  "name": "rams-connector",
  "version": "0.1.0",
  "private": true,
  "description": "RAMS Connector — reads TallyPrime over its local XML/HTTP port. Phase 0: read-only probe + analysis.",
  "main": "src/cli.js",
  "bin": {
    "rams-connector": "src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ping": "node src/cli.js ping",
    "companies": "node src/cli.js companies",
    "probe": "node src/cli.js probe",
    "roms-refs": "node src/cli.js roms-refs",
    "analyze": "node src/cli.js analyze",
    "mock": "node mock/server.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "fast-xml-parser": "^5.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
