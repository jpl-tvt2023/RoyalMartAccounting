# Test-only settings, committed: a local SQLite file and dummy secrets.
NODE_ENV=test
PORT=0

TURSO_DATABASE_URL=file:./tests/.tmp/test.db
TURSO_AUTH_TOKEN=

JWT_ACCESS_SECRET=test-access-secret-not-for-real-use
JWT_REFRESH_SECRET=test-refresh-secret-not-for-real-use
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

FRONTEND_URL=http://localhost:5174
