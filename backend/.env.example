PORT=5001
NODE_ENV=development

# Local SQLite by default. The RAMS test DB is
# libsql://royalmart-rams-test-royalmart.aws-ap-south-1.turso.io (token from the
# Turso dashboard). Check which DB this points at before `npm run migrate`.
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# Different from ROMS's. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS — comma-separated list of allowed origins (the RAMS frontend).
FRONTEND_URL=http://localhost:5174

# npm run bootstrap-admin only: the first Admin, created once when no Admin
# exists. Must change the password at first sign-in. Remove after use.
RAMS_ADMIN_USERNAME=
RAMS_ADMIN_PASSWORD=
RAMS_ADMIN_NAME=
